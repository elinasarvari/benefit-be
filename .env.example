# Copy to .env (make setup does this and fills in the generated secrets).
# Never commit .env. Only this example file is committed.

# Runtime and stores
APP_ENV=dev
DEMO_PROFILE=true
LOG_LEVEL=INFO
LOG_FORMAT=json
API_PORT=8000
WORKER_HEALTH_PORT=8001
WEB_ORIGIN=http://localhost:5173
BENEFIT_FE_DIR=../benefit-fe
# Generated by make setup (MongoDB users benefit_app and benefit_owner)
MONGO_URL_APP=
MONGO_URL_OWNER=
MONGO_DB=benefit
MONGO_AUDIT_DB=benefit_audit
MONGO_DATA_DIR=.data/mongo
DUCKDB_PATH=.data/reporting.duckdb
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=benefit-case
REDETERMINATION_SCHEDULE_ENABLED=true
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_ATTEMPTS=3

# Identity and sessions
IDENTITY_PROVIDER=local
# Generated by make setup (at least 32 bytes each, and different from each other)
SESSION_SECRET=
SESSION_TTL_HOURS=8
SYSTEM_CREDENTIAL_SECRET=
# Generated by make setup; used by the seed command and the Playwright setup
DEMO_PASSWORD=
# Fixed "today" for the synthetic data set; every seeded date is an offset from it (ADR-003-04)
SEED_ANCHOR_DATE=2026-11-10

# AI provider and modes
LLM_PROVIDER=anthropic
LLM_MODE=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-opus-5-5
AWS_REGION=
AWS_PROFILE=
BEDROCK_MODEL_ID=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
LLM_RECORDINGS_DIR=tests/fixtures/llm
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
MCP_TOOL_TIMEOUT_SECONDS=15

# Retrieval models (default: qwen and bge in dev and prod, fake when APP_ENV=test)
EMBEDDER=
RERANKER=

# Tracing (default: on in dev and prod, off when APP_ENV=test)
TRACING_ENABLED=
TRACING_OTLP_ENDPOINT=http://localhost:6006/v1/traces
TRACING_PROJECT=benefit

# Review queue (case-clock days; escalation must be greater than reminder)
REVIEW_REMINDER_DAYS=2
REVIEW_ESCALATION_DAYS=4

# Applicant waits (case-clock days, FR-011-01)
RESPONSE_WINDOW_DAYS=15
